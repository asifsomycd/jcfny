{
  "name": "roots/bedrock",
  "type": "project",
  "license": "MIT",
  "description": "WordPress boilerplate with modern development tools, easier configuration, and an improved folder structure",
  "homepage": "https://roots.io/bedrock/",
  "authors": [
    {
      "name": "Scott Walkinshaw",
      "email": "scott.walkinshaw@gmail.com",
      "homepage": "https://github.com/swalkinshaw"
    },
    {
      "name": "Ben Word",
      "email": "ben@benword.com",
      "homepage": "https://github.com/retlehs"
    }
  ],
  "keywords": [
    "bedrock", "roots", "wordpress", "stack", "composer", "vagrant", "wp"
  ],
  "support": {
    "issues": "https://github.com/roots/bedrock/issues",
    "forum": "https://discourse.roots.io/category/bedrock"
  },
  "config": {
    "preferred-install": "dist"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    {
      "type": "package",
      "package": {
        "name": "advanced-custom-fields/advanced-custom-fields-pro",
        "version": "5.7.13",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://connect.advancedcustomfields.com/index.php?p=pro&a=download"
        },
        "require": {
          "philippbaschke/acf-pro-installer": "^1.0",
          "composer/installers": "^1.0"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "gravityforms/gravityforms",
        "version": "2.4.8.3",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://s3.amazonaws.com/gravityforms/releases/gravityforms_2.4.8.3.zip?AWSAccessKeyId=AKIAJC3LQNDWHBOFBQIA&Expires=1555023914&Signature=7J3vCapDSocjd3XFl9L0TaPOE14%3D"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "gravityforms/gravityformsgutenberg",
        "version": "1.0.1",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://s3.amazonaws.com/gravityforms/addons/gutenberg/gravityformsgutenberg_1.0-rc-1.2.zip?AWSAccessKeyId=AKIAJC3LQNDWHBOFBQIA&Expires=1554951914&Signature=dRWGucypMJIRZGCqPyOr6Z1CTlw%3D"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "gravityforms/gravityformsrestapi",
        "version": "2.0.1",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://s3.amazonaws.com/gravityforms/addons/restapi/gravityformsrestapi_2.0-rc-1.zip?AWSAccessKeyId=AKIAJC3LQNDWHBOFBQIA&Expires=1554951914&Signature=hIdwJFapPoYo1zzXooNa3tRU9vg%3D"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "gravityforms/gravityformsmailchimp",
        "version": "4.6.0",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://s3.amazonaws.com/gravityforms/addons/mailchimp/gravityformsmailchimp_4.6.zip?AWSAccessKeyId=AKIAJC3LQNDWHBOFBQIA&Expires=1555023915&Signature=pZRa0cbfdWv%2B%2FE%2FyS%2Fv6VkOHx6Y%3D"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "gravityforms/gravityformspartialentries",
        "version": "1.3.0",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://s3.amazonaws.com/gravityforms/addons/partialentries/gravityformspartialentries_1.3.zip?AWSAccessKeyId=AKIAJC3LQNDWHBOFBQIA&Expires=1555023915&Signature=EFrWMvv2Q49Bqn8CId0Jc15SGH8%3D"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "backupbuddy/backupbuddy",
        "version": "8.3.10.0",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://s3.amazonaws.com/wp-boilerplate/plugins/backupbuddy-8.3.10.0.zip"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "mdsimpson/contact-form-7-to-database-extension",
        "version": "master",
        "type": "wordpress-plugin",
        "source": {
          "url": "https://github.com/mdsimpson/contact-form-7-to-database-extension.git",
          "type": "git",
          "reference":"master"
        }
      }
    },
    {
      "url": "https://github.com/joshuafredrickson/wp-sync-db.git",
      "type": "git"
    },
    {
      "url": "https://github.com/joshuafredrickson/wp-sync-db-media-files.git",
      "type": "git"
    },
    {
      "url": "https://github.com/joshuafredrickson/wp-sync-db-cli.git",
      "type": "git"
    }
  ],
  "require": {
    "php": ">=7.1",
    "composer/installers": "^1.4",
    "vlucas/phpdotenv": "^2.0.1",
    "oscarotero/env": "^1.1.0",
    "roots/wp-password-bcrypt": "1.0.0",
    "roots/wp-config": "1.0.0",
    "advanced-custom-fields/advanced-custom-fields-pro": "5.7.13",
    "gravityforms/gravityforms": "2.4.8.3",
    "gravityforms/gravityformsrestapi": "2.*",
    "gravityforms/gravityformsgutenberg": "1.*",
    "gravityforms/gravityformspartialentries": "^1.3",
    "gravityforms/gravityformsmailchimp": "^4.6.0",
    "wpackagist-plugin/acf-gravityforms-add-on": "1.*",
    "wpackagist-plugin/akismet": "4.*",
    "wpackagist-plugin/autoptimize": "2.*",
    "wpackagist-plugin/clickdesk-live-support-chat-plugin": "4.*",
    "wpackagist-plugin/page-links-to": "3.*",
    "wpackagist-plugin/quick-pagepost-redirect-plugin": "5.*",
    "wpackagist-plugin/safe-svg": "1.9.*",
    "wpackagist-plugin/sucuri-scanner": "1.*",
    "wpackagist-plugin/wordfence": "7.*",
    "wpackagist-plugin/wp-super-cache": "1.*",
    "wpackagist-plugin/enable-media-replace": "^3.2",
    "mdsimpson/contact-form-7-to-database-extension": "2.*",
    "wp-sync-db/wp-sync-db-media-files": "dev-master",
    "wp-sync-db/wp-sync-db": "dev-master",
    "wp-sync-db/wp-sync-db-cli": "dev-master",
    "yoast/wordpress-seo": "10.*",
    "roots/wordpress": "^5.1",
    "backupbuddy/backupbuddy": "^8.3"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.0.2",
    "roave/security-advisories": "dev-master"
  },
  "extra": {
    "installer-paths": {
      "html/app/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
      "html/app/plugins/{$name}/": ["type:wordpress-plugin"],
      "html/app/themes/{$name}/": ["type:wordpress-theme"]
    },
    "wordpress-install-dir": "html/wp"
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"copy('.env.example', '.env');\""
    ],
    "test": [
      "phpcs"
    ]
  }
}
